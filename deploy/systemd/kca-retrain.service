[Unit]
Description=KCA weekly ranker bundle retrain + re-certification (containerized)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 실측 최대 139초 → 2시간
TimeoutStartSec=2h
ExecStart=/usr/bin/docker run --rm --name kca-retrain --user %U:%G -e HOME=/tmp -e UV_CACHE_DIR=/tmp/uv-cache --memory=6g --cpus=1.8 --memory-swap=8g --env-file %h/quant-secrets/k-closing-alpha.env -v %h/k-closing-alpha/data:/app/data -v %h/k-closing-alpha/artifacts:/app/artifacts ghcr.io/kthyeong/k-closing-alpha:latest uv run python -m src.ml.retrain --train-ranker-bundle
ExecStopPost=-/usr/bin/docker rm -f kca-retrain
