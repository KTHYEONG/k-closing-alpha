[Unit]
Description=KCA offsite backup retention prune (remove _deleted snapshots older than 30 days)
OnFailure=kca-alert@%n.service
After=kca-backup.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
ExecStart=%h/.local/bin/uv run python -m src.tools.backup_prune
