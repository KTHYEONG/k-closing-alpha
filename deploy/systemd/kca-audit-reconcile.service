[Unit]
Description=KCA audit reconcile (re-measure self-healing conditions)
OnFailure=kca-alert@%n.service
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
EnvironmentFile=%h/quant-secrets/kis-data.env
Environment=TZ=Asia/Seoul
Environment=BROKER_ADMISSION_CLASS=standard
TimeoutStartSec=15min
ExecStartPre=/usr/bin/sudo /usr/bin/chown -R ubuntu:ubuntu %h/k-closing-alpha/data %h/k-closing-alpha/artifacts %h/.cache/kis
ExecStart=/usr/bin/flock -w 600 %t/kca-audit.lock %h/.local/bin/uv run python -m src.tools.audit_reconcile
