[Unit]
Description=KCA optional auction close capture (research, no orders)
After=kca-collect.service
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
EnvironmentFile=%h/quant-secrets/kis-data.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=batch
# 실측 최대 501초 → 15분 (15:30 장마감을 관통하도록 설계됨)
TimeoutStartSec=15min
ExecStart=%h/.local/lib/kca/kca-run auction-close --kis-data --admission critical --role batch -- uv run python -m src.daily.auction_capture --phase close
ExecStopPost=-/usr/bin/docker rm -f kca-auction-close
