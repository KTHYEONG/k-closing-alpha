[Unit]
Description=KCA intraday archive - NXT/KRX aftermarket bars only (evening batch)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 실측 최대 7302초 → 3시간 (After=로 대기하는 audit·backup이 막히지 않도록)
TimeoutStartSec=3h
# 14-day max 2182.719s (or-vps, 2026-10-08); 1.5x rounded up to 5min -> 3300s.
X-ExpectedRuntimeSec=3300
ExecStart=%h/.local/lib/kca/kca-run archive-intraday --kis-data --admission standard -- uv run python -m src.daily.archive_intraday --phase aftermarket
ExecStopPost=-/usr/bin/docker rm -f kca-archive-intraday
