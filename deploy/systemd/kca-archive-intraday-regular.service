[Unit]
Description=KCA intraday archive - regular session bars+ticks (evening batch, early)
After=kca-collect.service
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 실측 최대 6904초 → 3시간 (20:05 애프터마켓 적재 전에 종료)
TimeoutStartSec=3h
# 14-day max 4385.129s (or-vps, 2026-10-08); 1.5x rounded up to 5min -> 6600s.
X-ExpectedRuntimeSec=6600
ExecStart=%h/.local/lib/kca/kca-run archive-intraday-regular --kis-data --admission standard -- uv run python -m src.daily.archive_intraday --phase regular
ExecStopPost=-/usr/bin/docker rm -f kca-archive-intraday-regular
