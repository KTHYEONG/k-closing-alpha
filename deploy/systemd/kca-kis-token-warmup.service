[Unit]
Description=KCA KIS token warmup (host data slots, read-only)
OnFailure=kca-alert@%n.service
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
# RestartMode=direct는 중간 재시도에서 OnFailure를 억제하고 최종 실패에서만 알림한다
Restart=on-failure
RestartMode=direct
RestartSec=5min
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 시도당 실측 최대 4초 → 5분 (재시도 전체 예산은 08:00 이전에 종료)
TimeoutStartSec=5min
ExecStart=%h/.local/lib/kca/kca-run kis-token-warmup --kis-data --admission critical -- uv run python -m src.tools.kis_token_warmup
ExecStopPost=-/usr/bin/docker rm -f kca-kis-token-warmup
