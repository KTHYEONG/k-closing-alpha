[Unit]
Description=KCA offsite re-verification and restore drill (weekly remote integrity)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 주간 검증 상한 2시간 (core snapshot과 동일한 Drive 공유 잠금)
TimeoutStartSec=2h
ExecStart=/usr/bin/flock -w 7200 %t/quant-gdrive.lock %h/.local/bin/uv run python -m src.tools.capture_offsite verify
