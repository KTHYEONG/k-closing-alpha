[Unit]
Description=KCA daily audit (visualizes missing steps)
OnFailure=kca-alert@%n.service
After=network.target kca-archive-intraday.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
EnvironmentFile=%h/quant-secrets/kis-data.env
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/docker run --rm --env-file %h/quant-secrets/k-closing-alpha.env --env-file %h/quant-secrets/kis-data.env -v %h/.cache/kis:/root/.cache/kis -v %h/k-closing-alpha/data:/app/data -v %h/k-closing-alpha/artifacts:/app/artifacts ghcr.io/kthyeong/k-closing-alpha:latest uv run python -m src.tools.daily_audit
