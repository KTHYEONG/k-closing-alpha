[Unit]
Description=KCA order reconcile entry — closing auction fills
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 15:30 발화 + 12분 상한 → 15:42 종료, 정규장 아카이브(15:40) 이후 정리
TimeoutStartSec=12min
ExecStart=%h/.local/lib/kca/kca-run order-reconcile-entry --admission critical -- uv run python -m src.daily.order_session --phase reconcile-entry
ExecStopPost=-/usr/bin/docker rm -f kca-order-reconcile-entry
