[Unit]
Description=KCA close finalization (confirmed EOD update)
After=kca-collect.service kca-predict.service
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=decision
# 실측 최대 144초 → 12분 (15:33 데드라인까지 폴링)
TimeoutStartSec=12min
ExecStart=%h/.local/lib/kca/kca-run finalize-close --kis-data --admission critical --role decision -- uv run python -m src.daily.finalize_close
ExecStopPost=-/usr/bin/docker rm -f kca-finalize-close
ExecStopPost=/usr/bin/systemctl --user start --no-block kca-paper-entry.service
