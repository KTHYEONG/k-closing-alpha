[Unit]
Description=KCA close finalization (confirmed EOD update)
After=kca-collect.service kca-predict.service
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=decision
ExecStart=%h/.local/bin/uv run python -m src.daily.finalize_close
ExecStopPost=/usr/bin/systemctl --user start --no-block kca-paper-entry.service
