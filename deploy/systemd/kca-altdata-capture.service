[Unit]
Description=KCA optional slow-data capture (research, no orders)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
# 실측 최대 245초 → 1800초 (기존 유지)
TimeoutStartSec=1800
# 14-day max 287.133s (or-vps, 2026-10-08); 1.5x rounded up to 5min -> 600s.
X-ExpectedRuntimeSec=600
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
EnvironmentFile=%h/quant-secrets/kis-data.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=batch
ExecStart=/usr/bin/docker run --rm --log-opt max-size=10m --log-opt max-file=3 --name kca-altdata-capture --user %U:%G -e HOME=/tmp -e UV_CACHE_DIR=/tmp/uv-cache --env-file %h/quant-secrets/k-closing-alpha.env --env-file %h/quant-secrets/kis-data.env -v %h/.cache/kis:/app/.cache/kis -e KIS_TOKEN_CACHE_DIR=/app/.cache/kis -e BROKER_ADMISSION_CLASS=standard -v %h/k-closing-alpha/data:/app/data -v %h/k-closing-alpha/artifacts:/app/artifacts -e KIS_DATA_ROLE=batch ghcr.io/kthyeong/k-closing-alpha:latest uv run python -m src.daily.altdata_capture
ExecStopPost=-/usr/bin/docker rm -f kca-altdata-capture
