[Unit]
Description=KCA immutable core snapshot (weekly rebuild-irreplaceable panels)
OnFailure=kca-alert@%n.service
After=kca-retrain.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 주간 스냅샷 상한 2시간 (기존 유지)
TimeoutStartSec=2h
ExecStart=/usr/bin/flock -w 7200 %t/quant-gdrive.lock %h/.local/bin/uv run python -m src.tools.core_snapshot
