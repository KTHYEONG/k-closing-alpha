[Unit]
Description=KCA research roster capture at the closing auction (research, no orders)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
TimeoutStartSec=5min
ExecStart=%h/.local/lib/kca/kca-run research-roster --admission standard -- uv run python -m src.daily.roster_capture
ExecStopPost=-/usr/bin/docker rm -f kca-research-roster
