[Unit]
Description=KCA paper exit (no real orders)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=decision
# 실측 최대 4초 → 15분 (기존 유지)
TimeoutStartSec=15min
ExecStart=/usr/bin/docker run --rm --log-opt max-size=10m --log-opt max-file=3 --name kca-paper-exit --user %U:%G -e HOME=/tmp -e UV_CACHE_DIR=/tmp/uv-cache --env-file %h/quant-secrets/k-closing-alpha.env --env-file %h/quant-secrets/kis-data.env -v %h/.cache/kis:/app/.cache/kis -e KIS_TOKEN_CACHE_DIR=/app/.cache/kis -e BROKER_ADMISSION_CLASS=critical -v %h/k-closing-alpha/data:/app/data -v %h/k-closing-alpha/artifacts:/app/artifacts -e KIS_DATA_ROLE=decision ghcr.io/kthyeong/k-closing-alpha:latest uv run python -m src.daily.paper_trade --phase exit
ExecStopPost=-/usr/bin/docker rm -f kca-paper-exit
