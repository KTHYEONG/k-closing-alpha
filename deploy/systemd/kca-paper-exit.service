[Unit]
Description=KCA paper exit (no real orders)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=decision
# Ceiling covering the 600 s max pre-start wait plus the extended-open retry budget (measured runtime is seconds).
TimeoutStartSec=30min
ExecStart=%h/.local/lib/kca/kca-run paper-exit --kis-data --admission critical --role decision -- uv run python -m src.daily.paper_trade --phase exit
ExecStopPost=-/usr/bin/docker rm -f kca-paper-exit
