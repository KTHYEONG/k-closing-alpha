[Unit]
Description=KCA order exit — pre-open market sells
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 08:40 발화 + 18분 상한 → 08:58 종료, 09:00 시가단일가 전 마감
TimeoutStartSec=18min
ExecStart=%h/.local/lib/kca/kca-run order-exit --admission critical -- uv run python -m src.daily.order_session --phase exit
ExecStopPost=-/usr/bin/docker rm -f kca-order-exit
