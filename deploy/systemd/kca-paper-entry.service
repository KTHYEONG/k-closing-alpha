[Unit]
Description=KCA paper entry (no real orders)
OnFailure=kca-alert@%n.service
After=kca-finalize-close.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=decision
# 실측 최대 4초 → 10분
TimeoutStartSec=10min
ExecStart=%h/.local/lib/kca/kca-run paper-entry --kis-data --admission critical --role decision -- uv run python -m src.daily.paper_trade --phase entry
ExecStopPost=-/usr/bin/docker rm -f kca-paper-entry
