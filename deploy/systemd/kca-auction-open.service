[Unit]
Description=KCA optional auction open capture (research, no orders)
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
EnvironmentFile=%h/quant-secrets/kis-data.env
Environment=TZ=Asia/Seoul
Environment=KIS_DATA_ROLE=batch
# 실측 최대 1385초 → 40분
TimeoutStartSec=40min
ExecStart=%h/.local/lib/kca/kca-run auction-open --kis-data --admission critical --role batch -- uv run python -m src.daily.auction_capture --phase open
ExecStopPost=-/usr/bin/docker rm -f kca-auction-open
