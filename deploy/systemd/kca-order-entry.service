[Unit]
Description=KCA order entry — closing auction limit buys
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 15:21 발화 + 8분 상한 → 15:29 종료, 15:30 종가단일가 전 마감 (코드 데드라인이 우선)
TimeoutStartSec=8min
ExecStart=%h/.local/lib/kca/kca-run order-entry --admission critical -- uv run python -m src.daily.order_session --phase entry
ExecStopPost=-/usr/bin/docker rm -f kca-order-entry
