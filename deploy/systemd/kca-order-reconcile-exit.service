[Unit]
Description=KCA order reconcile exit — morning sell fills
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 09:00 발화 + 32분 상한 → 09:32 종료
TimeoutStartSec=32min
ExecStart=%h/.local/lib/kca/kca-run order-reconcile-exit --admission critical -- uv run python -m src.daily.order_session --phase reconcile-exit
ExecStopPost=-/usr/bin/docker rm -f kca-order-reconcile-exit
