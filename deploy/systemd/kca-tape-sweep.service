[Unit]
Description=KCA daily tick tape sweep - recover recent needs from Kiwoom tapes (after evening archive)
After=kca-archive-intraday.service
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
Environment=TZ=Asia/Seoul
# 일일 재검사(최대 25일분 needs) → 1시간 (archive·extended-backfill 슬롯과 겹치지 않는 20:35 발화)
TimeoutStartSec=3600
# 14-day max 1608.074s (or-vps, 2026-10-08); 1.5x rounded up to 5min -> 2700s.
X-ExpectedRuntimeSec=2700
ExecStart=%h/.local/lib/kca/kca-run tape-sweep --admission bulk -- uv run python -m src.daily.tick_tape_sweep
ExecStopPost=-/usr/bin/docker rm -f kca-tape-sweep
