[Unit]
Description=KCA closing-auction indicative path capture (research, no orders)
After=kca-collect.service
OnFailure=kca-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/k-closing-alpha
EnvironmentFile=%h/quant-secrets/k-closing-alpha.env
EnvironmentFile=%h/quant-secrets/kis-data.env
Environment=TZ=Asia/Seoul
# Mega-cap backfill reaches 15:20 in ~25 pages; 60 pages cover the cohort with headroom.
TimeoutStartSec=3h20min
ExecStart=%h/.local/lib/kca/kca-run auction-path --kis-data --admission bulk -- uv run python -m src.daily.auction_path
ExecStopPost=-/usr/bin/docker rm -f kca-auction-path
